# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
*/build/
!gradle/wrapper/gradle-wrapper.jar

# Local configuration file (sdk path, etc)
local.properties

# Log Files
*.log

# Android Navigation Editor temp files
.navigation/

# Android Studio captures directory
captures/

# External libs
libs/

# Keystore files
# Uncomment the following lines if you have jks keystore in your project
# *.jks
# *.keystore

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEA and Android Studio specific ignores
.idea/
    # Caches
    .idea/caches/
    .idea/libraries/

    # XML files that often change due to gradle sync
    .idea/dictionaries/
    .idea/jarRepositories.xml
    .idea/workspace.xml
    .idea/tasks.xml
    .idea/gradle.xml
    .idea/navEditor.xml

# Do not ignore the misc.xml file as it contains JDK settings
!.idea/misc.xml
!.idea/codeStyles/

# Module files
*.iml
atlassian-ide-plugin.xml

# User-specific stuff
# Remove this line if you want to share run/debug configurations with your team
# .idea/runConfigurations/*

# kotlin/data folder from newer versions of the plugin
.kotlin/